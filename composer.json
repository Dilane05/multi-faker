{
    "name": "cupidontech/multi-faker",
    "description": "Package for generating Faker by country",
    "version": "1.1.0",
    "type": "library",
    "homepage" : "https://github.com/Dilane05/multi-faker",
    "license": "MIT",
    "authors": [
        {
            "name": "cupidontech",
            "email": "cupidontech@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "fakerphp/faker": "^1.23",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Cupidontech\\MultiFaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cupidontech\\MultiFaker\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cupidontech\\MultiFaker\\MultiFakerServiceProvider"
            ]
        }
    }
}
